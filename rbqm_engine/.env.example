# DATABASE
# Default uses local SQLite. Change to your Supabase/Postgres URL for production.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./rbqm.db

# API
# Secret key for JWT signing. Change this in production!
SECRET_KEY=dev_secret_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# GROQ AI (Optional - for reports)
# Get your API key at https://console.groq.com/
# GROQ_API_KEY=gsk_...
